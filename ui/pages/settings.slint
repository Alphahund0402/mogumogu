import { ScrollView, SpinBox, CheckBox } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions } from "../store.slint";
import { UiButton, Panel, SettingToggle, PageHeader, PillField, StatusChip, MochiCallout } from "../components.slint";

export component SettingsPage inherits VerticalLayout {
    min-width: 0px;
    preferred-width: 0px;
    property <bool> compact: Store.window-width < 820px + 188px + 2 * Theme.page-padding;
    spacing: Theme.gap;
    PageHeader {
        title: "Einstellungen";
        description: "Überwachung, Hinweise und Daten verwalten. Schalter werden sofort gespeichert.";
    }
    ScrollView {
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        VerticalLayout {
            spacing: Theme.gap; alignment: start; padding-right: 16px; padding-bottom: 12px;
            GridLayout {
                spacing: Theme.gap;
                SettingToggle {
                    col: 0;
                    row: 0;
                    title: "Überwachung";
                    description: "Änderungen in freigegebenen Projektordnern automatisch erfassen.";
                    checked: Store.monitoring; enabled: !Store.demo;
                    toggled(on) => { Actions.set-monitoring(on); }
                    if Store.pause-text != "" : MochiCallout {
                        pose: 5; figure: 60px;
                        title: Store.pause-text;
                        text: "Automatische Neuerfassung ruht. „Jetzt erfassen“ geht trotzdem.";
                        UiButton { small: true; label: "Fortsetzen"; y: (parent.height - self.height) / 2; available: !Store.demo && !Store.busy; activated => { Actions.pause-monitoring(0); } }
                    }
                    if Store.pause-text == "" && Store.monitoring : FlexboxLayout {
                        spacing: 6px; alignment: start;
                        UiButton { small: true; has-icon: true; icon: Icons.pause; label: "1 Stunde pausieren"; available: !Store.demo && !Store.busy; activated => { Actions.pause-monitoring(60); } }
                        UiButton { small: true; label: "Bis morgen früh"; available: !Store.demo && !Store.busy; activated => { Actions.pause-monitoring(-1); } }
                    }
                }
                SettingToggle {
                    col: root.compact ? 0 : 1;
                    row: root.compact ? 1 : 0;
                    title: "Tray-Hinweise";
                    description: "Neue Prüfhinweise gesammelt im Tray anzeigen. Pfade und Paketnamen bleiben verborgen.";
                    checked: Store.notifications; enabled: !Store.demo;
                    toggled(on) => { Actions.set-notifications(on); }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        CheckBox {
                            text: "Einmal täglich um";
                            checked: Store.daily-summary;
                            enabled: Store.notifications && !Store.demo && Store.modal == 0;
                            toggled => { Actions.set-daily-summary(self.checked); }
                        }
                        SpinBox {
                            width: 62px;
                            accessible-label: "Uhrzeit der täglichen Zusammenfassung";
                            value: Store.summary-hour; minimum: 0; maximum: 23;
                            enabled: Store.notifications && Store.daily-summary && !Store.demo && Store.modal == 0;
                            edited(value) => { Actions.set-summary-hour(value); }
                        }
                        Text { text: "Uhr"; font-size: 11.5px; color: Theme.muted; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        CheckBox {
                            text: "Ruhezeit von";
                            checked: Store.quiet-enabled;
                            enabled: Store.notifications && !Store.demo && Store.modal == 0;
                            toggled => { Actions.set-quiet(self.checked, Store.quiet-from, Store.quiet-to); }
                        }
                        SpinBox {
                            width: 62px;
                            accessible-label: "Beginn der Ruhezeit";
                            value: Store.quiet-from; minimum: 0; maximum: 23;
                            enabled: Store.notifications && Store.quiet-enabled && !Store.demo && Store.modal == 0;
                            edited(value) => { Actions.set-quiet(true, value, Store.quiet-to); }
                        }
                        Text { text: "bis"; font-size: 11.5px; color: Theme.muted; vertical-alignment: center; }
                        SpinBox {
                            width: 62px;
                            accessible-label: "Ende der Ruhezeit";
                            value: Store.quiet-to; minimum: 0; maximum: 23;
                            enabled: Store.notifications && Store.quiet-enabled && !Store.demo && Store.modal == 0;
                            edited(value) => { Actions.set-quiet(true, Store.quiet-from, value); }
                        }
                        Text { text: "Uhr"; font-size: 11.5px; color: Theme.muted; vertical-alignment: center; }
                    }
                }
            }
            GridLayout {
                spacing: Theme.gap;
                SettingToggle {
                    col: 0;
                    row: 0;
                    title: "Mit Windows starten";
                    description: "mogumogu nach der Anmeldung im Tray starten. Das Fenster bleibt geschlossen.";
                    checked: Store.autostart; enabled: !Store.demo && Store.autostart-available;
                    toggled(on) => { Actions.set-autostart(on); }
                    if Store.autostart-note != "" : Text { text: Store.autostart-note; font-size: 11px; color: Theme.review-ink; wrap: word-wrap; }
                }
                SettingToggle {
                    col: root.compact ? 0 : 1;
                    row: root.compact ? 1 : 0;
                    title: "Geführter Einstieg";
                    description: "Bei leerem Inventar durch Ordnerwahl, Lesefreigabe und erste Erfassung führen.";
                    checked: Store.guide-enabled; enabled: !Store.demo;
                    toggled(on) => { Actions.set-guide(on); }
                    HorizontalLayout {
                        alignment: start;
                        UiButton { small: true; label: "Jetzt starten"; available: !Store.demo && !Store.busy; activated => { Actions.guide-start(); } }
                    }
                }
            }
            GridLayout {
                spacing: Theme.gap;
                SettingToggle {
                    col: 0;
                    row: 0;
                    title: "Updatehinweise";
                    description: "Netzwerk nur für unten freigegebene öffentliche Quellen erlauben. Private Quellen werden nie abgefragt.";
                    checked: Store.updates; enabled: !Store.demo;
                    toggled(on) => { Actions.set-updates(on); }
                    for source in Store.sources : HorizontalLayout {
                        spacing: 8px;
                        Text { text: source.host; min-width: 0px; overflow: elide; font-size: 11.5px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
                        UiButton {
                            small: true;
                            label: source.enabled ? "Freigegeben" : "Freigeben";
                            selected: source.enabled;
                            checkable: true;
                            has-icon: source.enabled;
                            icon: Icons.check;
                            available: Store.updates && !Store.demo && !Store.busy;
                            activated => { Actions.set-source(source.host, !source.enabled); }
                        }
                    }
                }
                Panel {
                    col: root.compact ? 0 : 1;
                    row: root.compact ? 1 : 0;
                    title: "Ordner für Scratchpads";
                    Text { text: "Neue Scratchpads mit Quellcode, Umgebung, temporären Daten und Ergebnissen hier anlegen."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
                    root-field := PillField { text: Store.scratch-root; icon: Icons.folder; placeholder: "C:\\dev\\scratch"; label: "Scratchpad-Wurzel"; enabled: !Store.demo && Store.modal == 0 && !Store.busy; }
                    FlexboxLayout {
                        spacing: 8px; alignment: start;
                        UiButton { small: true; label: "Durchsuchen …"; available: !Store.demo && !Store.busy; activated => { Actions.browse-scratch-root(); } }
                        UiButton { small: true; primary: true; label: "Speichern"; available: !Store.demo && !Store.busy; activated => { Actions.save-scratch-root(root-field.text); } }
                    }
                }
            }
            GridLayout {
                spacing: Theme.gap;
                Panel {
                    col: 0;
                    row: 0;
                    title: "Daten sichern und teilen";
                    Text { text: "Sicherung für dich; Export zum Teilen. Der redigierte Export verbirgt Pfade, Projektnamen und private Paketnamen."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
                    FlexboxLayout {
                        spacing: 8px; alignment: start;
                        UiButton { small: true; label: "Sicherung erstellen …"; available: !Store.demo && !Store.busy; activated => { Actions.backup-now(); } }
                        UiButton { small: true; label: "Redigiert exportieren …"; available: !Store.busy; activated => { Actions.export-now(false); } }
                        UiButton { small: true; label: "Mit Pfaden exportieren …"; available: !Store.busy; activated => { Actions.export-now(true); } }
                    }
                }
                Panel {
                    col: root.compact ? 0 : 1;
                    row: root.compact ? 1 : 0;
                    title: "Datenort und Modus";
                    Text { text: Store.demo ? "Demo · eigene Datenbank, schreibgeschützt" : "Lokales Inventar"; font-size: 11.5px; color: Theme.ink; wrap: word-wrap; }
                    Text { text: Store.data-path; font-size: 10.5px; color: Theme.muted; wrap: word-wrap; }
                    Text { text: "SQLite " + Store.sqlite-version + " · Fenster schließen beendet die App nicht."; font-size: 10.5px; color: Theme.muted; wrap: word-wrap; }
                }
            }
            Panel {
                title: "Bereinigung";
                chip: "Gesperrt"; chip-kind: "locked";
                Text { text: Store.cleanup-status; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
            }
            HorizontalLayout {
                spacing: 12px; alignment: start;
                UiButton { label: "In den Tray wechseln"; available: true; activated => { Actions.hide-dashboard(); } }
                Text { text: "Strg+K Suche · Strg+N Projekt · F5 Aktualisieren · Alt+1…9, Alt+0 Bereiche · Esc schließen"; font-size: 11px; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
    }
}
