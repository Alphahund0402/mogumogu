import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions, ChainStep } from "../store.slint";
import { Activatable, UiButton, StatusChip, TableHead, Callout, Icon } from "../components.slint";

export component PackageInventory inherits VerticalLayout {
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    property <bool> show-update: !Store.package-panel;
    spacing: 4px;
    TableHead {
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px; spacing: 10px;
            Text { text: "Paket · Version"; horizontal-stretch: 1; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
            Text { text: "Quellenstatus"; width: 128px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
            Text { text: "Projektbelege"; width: 150px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
            if root.show-update : Text { text: "Update"; width: 96px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
        }
    }
    if Store.packages.length == 0 : VerticalLayout {
        alignment: center; vertical-stretch: 1; spacing: 8px; padding: 16px;
        Text { text: Store.demo ? "Die Demo enthält keine geprüften Paketversionen." : Store.package-search != "" || Store.package-filter != 0 ? "Keine Pakete passen zu Suche und Filter." : "Noch keine Paketversionen erfasst."; color: Theme.ink; font-size: 13px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: Store.package-search != "" || Store.package-filter != 0 ? "Passe die Suche an oder setze den Filter auf „Alle“." : "Projektordner oder globalen Bestand freigeben und erfassen. Abkündigungen brauchen eine freigegebene Quellenabfrage."; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
        if Store.package-search != "" || Store.package-filter != 0 : HorizontalLayout {
            alignment: center;
            UiButton { small: true; label: "Filter zurücksetzen"; available: !Store.busy; activated => { Store.package-search = ""; Store.package-filter = 0; Actions.package-query(); } }
        }
    }
    if Store.packages.length > 0 : ListView {
        vertical-stretch: 1;
        for pkg in Store.packages : entry := Activatable {
            height: Theme.detail-row-height;
            border-radius: 10px;
            selection-kind: "package"; selection-key: pkg.key;
            label: pkg.name + " " + pkg.version + ". " + pkg.upstream + ". " + pkg.references + ". " + pkg.update;
            border-color: transparent;
            activated => { Actions.open-package(pkg.key); }
            if entry.selected : Rectangle { x: 2px; y: 10px; width: 3px; height: parent.height - 20px; border-radius: 2px; background: Theme.ink; }
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 10px;
                VerticalLayout {
                    alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                    Text { text: pkg.name; font-size: 12.5px; font-weight: 700; color: Theme.ink; overflow: elide; }
                    Text { text: pkg.version + " · " + pkg.source + (pkg.kept ? " · Behalten" : ""); font-size: 11px; color: Theme.muted; overflow: elide; }
                }
                HorizontalLayout { width: 128px; alignment: start; StatusChip { width: 128px; constrained: true; label: pkg.upstream; kind: pkg.upstream-kind; y: (parent.height - self.height) / 2; } }
                Text { text: pkg.references; width: 150px; font-size: 11.5px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                if root.show-update : Text { text: pkg.update; width: 96px; font-size: 11.5px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
            }
            Rectangle { x: 12px; width: parent.width - 24px; y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
    }
    HorizontalLayout {
        spacing: 6px; padding-left: 12px; padding-top: 4px;
        Text { text: Store.package-page-label; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        UiButton { label: "Zurück"; small: true; available: Store.package-previous && !Store.busy; activated => { Actions.package-page(Store.package-offset - Store.package-page-size); } }
        UiButton { label: "Weiter"; small: true; available: Store.package-next && !Store.busy; activated => { Actions.package-page(Store.package-offset + Store.package-page-size); } }
    }
}

// The height follows the wrapped copy at the actual column width. A repeated
// nested layout otherwise contributes its one-line height to the parent.
component EvidenceStep inherits Rectangle {
    in property <ChainStep> data;
    in property <bool> last;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: max(10px, copy.preferred-height) + 6px;
    Rectangle {
        x: 0px; y: 3px; height: 10px; width: 10px; border-radius: 5px;
        background: root.data.warn ? Theme.blush : Theme.surface;
        border-width: 2px; border-color: root.data.warn ? Theme.alert-ink : Theme.ink;
    }
    if !root.last : Rectangle { x: 4px; y: 13px; width: 2px; height: max(0px, root.height - 13px); background: Theme.chart-fog; }
    copy := VerticalLayout {
        x: 19px; y: 0px; width: max(0px, root.width - 19px); height: self.preferred-height;
        spacing: 1px; alignment: start;
        Text { text: root.data.label; font-size: 11.5px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
        Text { text: root.data.detail; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
    }
}

// "Warum ist das hier?" next to the list, or full-width in compact windows.
export component PackagePanel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: Theme.stroke;
    border-color: Theme.edge;
    ScrollView {
        width: parent.width; height: parent.height;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        VerticalLayout {
            padding: 14px; padding-right: 20px; spacing: 9px; alignment: start;
            HorizontalLayout {
                Text { text: "Warum ist das hier?"; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                UiButton { quiet: true; small: true; has-icon: true; icon: Icons.close; label: Store.window-width < 1060px + 188px + 2 * Theme.page-padding ? "Zur Liste" : ""; available: true; accessible-label: "Erklärung schließen und Paketliste anzeigen"; activated => { Actions.close-package(); } }
            }
            Text { text: Store.panel-title; font-size: 16px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
            HorizontalLayout { alignment: start; StatusChip { label: Store.panel-status; kind: Store.panel-status-kind; } }
            Text { text: Store.panel-source; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
            Text { text: "Belegkette"; font-size: 12px; font-weight: 700; color: Theme.ink; }
            VerticalLayout {
                spacing: 0px;
                for step[index] in Store.panel-chain : EvidenceStep { data: step; last: index == Store.panel-chain.length - 1; }
            }
            if Store.panel-advice != "" : Callout { kind: "warn"; icon: Icons.activity; text: Store.panel-advice; }
            Text { text: Store.panel-note; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
            FlexboxLayout {
                spacing: 8px; alignment: start;
                UiButton { small: true; label: "Alle Belege"; activated => { Actions.detail-action("package-dialog:" + Store.panel-key); } }
                UiButton { small: true; primary: !Store.panel-kept; label: Store.panel-kept ? "Behalten lösen" : "Behalten vormerken"; available: !Store.demo && !Store.busy; activated => { Actions.keep-package(Store.panel-key, !Store.panel-kept); } }
            }
            Text { text: "mogumogu ändert keine Manifeste oder Lockdateien."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        }
    }
}
