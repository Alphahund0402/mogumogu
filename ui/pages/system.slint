// Metadata-only system findings, shown as tabs of the package and AI pages.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions, SystemRow } from "../store.slint";
import { Card, CardTitle, UiButton, StatusChip, TableHead, Activatable } from "../components.slint";

component ToolLine inherits Activatable {
    in property <SystemRow> data;
    property <bool> details-open: false;
    height: max(Theme.row-height, tool-content.preferred-height);
    label: root.data.name + ", " + root.data.evidence + ", " + root.data.location + (root.details-open ? ", Details schließen" : ", Details anzeigen");
    activated => { root.details-open = !root.details-open; }
    tool-content := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        spacing: 0px; alignment: start;
        HorizontalLayout {
            height: Theme.row-height;
            padding-left: 12px; padding-right: 12px; spacing: 10px;
            Text { text: root.data.name; width: 140px; font-size: 12.5px; font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide; }
            Text { text: root.data.location; horizontal-stretch: 1; min-width: 40px; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
            HorizontalLayout { width: 120px; alignment: start; StatusChip { width: 120px; constrained: true; label: root.data.evidence; kind: root.data.evidence-kind; y: (parent.height - self.height) / 2; } }
            Text { text: root.details-open ? "−" : "+"; width: 12px; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
        }
        if root.details-open : VerticalLayout {
            width: root.width; height: self.preferred-height;
            padding-left: 12px; padding-right: 12px; padding-bottom: 10px; spacing: 4px;
            Text { text: root.data.location; font-size: 11px; color: Theme.text; wrap: word-wrap; }
            if root.data.note != "" : Text { text: root.data.note; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        }
    }
    Rectangle { x: 12px; width: parent.width - 24px; y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// A known place: approve it for reading, then scan it.
export component PlaceLine inherits Rectangle {
    in property <SystemRow> data;
    height: max(48px, place-content.preferred-height);
    border-radius: 12px;
    place-content := HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        padding-left: 10px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1; min-width: 0px;
            Text { text: root.data.name; font-size: 12px; font-weight: 700; color: Theme.ink; overflow: elide; }
            Text { text: root.data.location; font-size: 10.5px; color: Theme.muted; overflow: elide; }
            Text { text: root.data.approved ? root.data.coverage : root.data.note; font-size: 10.5px; color: root.data.approved ? Theme.ok-ink : Theme.muted; wrap: word-wrap; }
        }
        if root.data.approved : UiButton { y: (parent.height - self.height) / 2; small: true; label: "Erfassen"; available: !Store.demo && !Store.busy; activated => { Actions.open-scope-scan(root.data.scope-id); } }
        if !root.data.approved && root.data.approvable : UiButton {
            y: (parent.height - self.height) / 2;
            small: true; label: "Lesen erlauben";
            available: !Store.demo && !Store.busy;
            activated => { Actions.system-approve(root.data.id); }
        }
        if !root.data.approved && !root.data.approvable : StatusChip { y: (parent.height - self.height) / 2; label: root.data.evidence; kind: root.data.evidence-kind; }
    }
}

// Tools in the search path next to the known global package stores.
export component SystemOverview inherits VerticalLayout {
    min-width: 0px;
    preferred-width: 0px;
    property <bool> compact: Store.window-width < 1000px + 188px + 2 * Theme.page-padding;
    spacing: Theme.gap;
    HorizontalLayout {
        spacing: 10px;
        Text { text: "Gefunden über den Suchpfad und bekannte Orte. Nichts wurde gestartet."; font-size: 11.5px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
        Text { text: Store.system-checked; max-width: 220px; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
        UiButton { y: (parent.height - self.height) / 2; small: true; label: "Erneut prüfen"; has-icon: true; icon: Icons.refresh; available: !Store.demo && !Store.busy; activated => { Actions.system-refresh(); } }
        UiButton { y: (parent.height - self.height) / 2; small: true; label: "Ort hinzufügen …"; has-icon: true; icon: Icons.plus; available: !Store.demo && !Store.busy; activated => { Actions.add-store(); } }
    }
    GridLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;
        Card {
            col: 0; row: 0;
            min-height: 110px;
            horizontal-stretch: 13;
            min-width: 0px;
            VerticalLayout {
                CardTitle { title: "Werkzeuge"; eyebrow: Store.system-tools.length + " gefunden"; }
                TableHead {
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 10px;
                        Text { text: "Werkzeug"; width: 140px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                        Text { text: "Fundort"; horizontal-stretch: 1; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                        Text { text: "Beleg"; width: 120px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                        Rectangle { width: 12px; }
                    }
                }
                if Store.system-tools.length == 0 : HorizontalLayout {
                    padding: 14px;
                    Text { text: Store.demo ? "Im Demomodus wird das System nicht geprüft." : "Kein bekanntes Werkzeug im Suchpfad gefunden."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
                }
                ListView {
                    vertical-stretch: 1;
                    for row in Store.system-tools : tool-details-toggle := ToolLine { data: row; }
                }
            }
        }
        Card {
            col: root.compact ? 0 : 1;
            row: root.compact ? 1 : 0;
            min-height: 110px;
            horizontal-stretch: 10;
            min-width: 0px;
            VerticalLayout {
                CardTitle { title: "Globale Bestände"; eyebrow: Store.system-stores.length + " Orte"; }
                if Store.system-stores.length == 0 : HorizontalLayout {
                    padding: 14px;
                    Text { text: "Keine bekannten globalen Bestände gefunden."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
                }
                ListView {
                    vertical-stretch: 1;
                    for row in Store.system-stores : PlaceLine { data: row; }
                }
            }
        }
    }
}
