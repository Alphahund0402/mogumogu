import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions, ExperimentRow, SessionRow, FolderRow } from "../store.slint";
import { Card, Icon, UiButton, Activatable, StatusChip, PageHeader, Callout, MochiCallout, TableHead } from "../components.slint";

component ExperimentLine inherits Activatable {
    in property <ExperimentRow> data;
    height: Theme.detail-row-height;
    border-radius: Theme.radius-small;
    selection-kind: "experiment";
    selection-key: "" + root.data.id;
    selected: Store.experiment-id == root.data.id;
    label: root.data.name + ", " + root.data.project + ", " + root.data.state;
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 8px;
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
            Text { text: root.data.name; font-size: 12.5px; font-weight: 700; color: Theme.ink; overflow: elide; }
            Text { text: root.data.project + " · " + root.data.purpose; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        StatusChip { label: root.data.state; kind: root.data.state-kind; y: (parent.height - self.height) / 2; }
    }
}

component SessionLine inherits Rectangle {
    in property <SessionRow> data;
    // Short sessions stay compact; long purposes and notes remain readable.
    height: max(48px, session-content.preferred-height);
    border-radius: 12px;
    background: root.data.stall != "" ? Theme.blush-soft : #f6f9fc;
    session-content := HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        padding-left: 12px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
        Icon { source: Icons.activity; width: 15px; height: 15px; y: (parent.height - self.height) / 2; tone: root.data.stall != "" ? Theme.alert-ink : Theme.ok-ink; }
        VerticalLayout {
            height: self.preferred-height;
            alignment: center; spacing: 1px; horizontal-stretch: 1; min-width: 0px;
            Text { text: "Session " + root.data.id + " · " + root.data.purpose; font-size: 12px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
            Text { text: root.data.stall != "" ? root.data.stall + " · gestartet " + root.data.started : "gestartet " + root.data.started + (root.data.note != "" ? " · " + root.data.note : ""); font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        }
        StatusChip { label: root.data.state; kind: root.data.state-kind; y: (parent.height - self.height) / 2; }
        if root.data.releasable : UiButton {
            y: (parent.height - self.height) / 2;
            small: true; label: "Begründet freigeben";
            available: !Store.demo && !Store.busy;
            activated => { Actions.release-session(root.data.id); }
        }
    }
}

component FolderLine inherits Rectangle {
    in property <FolderRow> data;
    height: max(Theme.row-height, folder-content.preferred-height);
    folder-content := HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
        Icon { source: Icons.folder; width: 14px; height: 14px; y: (parent.height - self.height) / 2; tone: Theme.protected-ink; }
        Text { text: root.data.name; font-size: 12px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; wrap: word-wrap; }
        Text { text: root.data.size; width: 70px; font-size: 11.5px; color: Theme.text; vertical-alignment: center; }
        HorizontalLayout { width: 172px; alignment: start; StatusChip { width: 172px; constrained: true; label: root.data.fate; kind: root.data.fate-kind; y: (parent.height - self.height) / 2; } }
    }
    Rectangle { x: 12px; width: parent.width - 24px; y: parent.height - 1px; height: 1px; background: Theme.line; }
}

component ExperimentDetail inherits VerticalLayout {
    padding: 14px; spacing: Theme.gap;
    HorizontalLayout {
        spacing: 6px;
        Text { text: Store.experiment-name; font-size: 17px; font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
        if Store.experiment-review != "" : StatusChip { y: (parent.height - self.height) / 2; label: Store.experiment-review; kind: Store.experiment-review-kind; }
    }
    FlexboxLayout {
        spacing: 8px; alignment: start;
        UiButton { small: true; label: "+7 Tage"; available: !Store.demo && !Store.busy; activated => { Actions.experiment-action("extend", Store.experiment-id); } }
        UiButton { small: true; label: "Schützen"; has-icon: true; icon: Icons.lock; available: !Store.demo && !Store.busy; activated => { Actions.experiment-action("protect", Store.experiment-id); } }
        UiButton { small: true; label: "Zum Projekt machen"; available: !Store.demo && !Store.busy; activated => { Actions.experiment-action("promote", Store.experiment-id); } }
        UiButton { small: true; label: "Alle Angaben"; available: true; activated => { Actions.open-resource(Store.experiment-id); } }
    }
    Text { text: Store.experiment-path; font-size: 11px; color: Theme.muted; overflow: elide; }
    if Store.experiment-stall != "" : MochiCallout {
        kind: "alert"; pose: 6; figure: 68px;
        title: "Session wartet auf deine Entscheidung";
        text: Store.experiment-stall;
    }
    Text { text: "Sessions"; font-size: 12.5px; font-weight: 700; color: Theme.ink; }
    if Store.experiment-sessions.length == 0 : HorizontalLayout {
        spacing: 8px;
        Text { text: "Noch keine Session. Verwaltete Läufe startest du über die CLI."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
        UiButton { small: true; quiet: true; label: "CLI-Hilfe"; available: true; activated => { Actions.show-help(); } }
    }
    for session in Store.experiment-sessions : SessionLine { data: session; }
    Text { text: "Ordner"; font-size: 12.5px; font-weight: 700; color: Theme.ink; }
    VerticalLayout {
        spacing: 0px;
        TableHead {
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 10px;
                Rectangle { width: 14px; }
                Text { text: "Ordner"; horizontal-stretch: 1; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                Text { text: "Größe"; width: 70px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                Text { text: "Zustand"; width: 172px; font-size: 11px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
            }
        }
        for folder in Store.experiment-folders : FolderLine { data: folder; }
    }
    if Store.experiment-plannable : HorizontalLayout {
        spacing: 10px;
        UiButton { primary: true; label: "Aufräumplan anzeigen …"; available: !Store.demo && !Store.busy; activated => { Actions.experiment-action("plan", Store.experiment-id); } }
        Text { text: "Zeigt zuerst einen Plan. Ausgeführt wird nur in Wegwerf-Testordnern."; font-size: 11px; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
    }
}

export component ExperimentsPage inherits VerticalLayout {
    min-width: 0px;
    preferred-width: 0px;
    property <bool> compact: Store.window-width < 1000px + 188px + 2 * Theme.page-padding;
    spacing: Theme.gap;
    HorizontalLayout {
        spacing: 10px;
        PageHeader {
            horizontal-stretch: 1;
            title: "Experimente";
            description: "Scratchpads und ihre verwalteten Läufe.";
        }
        UiButton { y: (parent.height - self.height) / 2; primary: true; label: "Scratchpad anlegen"; has-icon: true; icon: Icons.plus; available: !Store.demo && !Store.busy; activated => { Actions.new-scratch(); } }
    }
    if Store.stalled-count > 0 : Callout {
        kind: "alert"; icon: Icons.warning;
        text: Store.stalled-count + (Store.stalled-count == 1 ? " Session hängt." : " Sessions hängen.") + " Prüfe die Ergebnisse und gib die Session frei; mogumogu beendet keine Prozesse.";
    }
    GridLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;
        Card {
            col: 0; row: 0;
            min-width: 0px;
            preferred-width: 262px;
            max-width: root.compact ? 100000px : 262px;
            preferred-height: root.compact ? 120px : 0px;
            max-height: root.compact ? 160px : 100000px;
            vertical-stretch: root.compact ? 0 : 1;
            VerticalLayout {
                padding: 8px; spacing: 2px;
                if Store.experiments.length == 0 : Text {
                    text: "Noch keine Scratchpads. Ein Scratchpad ist ein Arbeitsordner für einen Versuch, mit Quellcode, Umgebung, Temporärem und Ergebnissen.";
                    font-size: 11.5px; color: Theme.muted; wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for row in Store.experiments : ExperimentLine { data: row; activated => { Actions.select-experiment(row.id); } }
                }
            }
        }
        Card {
            col: root.compact ? 0 : 1;
            row: root.compact ? 1 : 0;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-width: 0px;
            if Store.experiment-id < 0 : Text {
                x: 16px; y: 16px; width: parent.width - 32px;
                text: "Wähle ein Experiment, um seine Läufe und Ordner zu sehen.";
                font-size: 12px; color: Theme.muted; wrap: word-wrap;
            }
            if Store.experiment-id >= 0 : ScrollView {
                width: parent.width; height: parent.height;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                ExperimentDetail { padding-right: 20px; alignment: start; }
            }
        }
    }
}
