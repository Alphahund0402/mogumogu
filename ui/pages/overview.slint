import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions, AttentionCard } from "../store.slint";
import { Icon, UiButton, FilterChip, StatusChip, PageHeader, RowCard, Activatable, Card } from "../components.slint";

// One key figure; opens the page that lists it.
component FigureTile inherits Activatable {
    in property <string> value;
    in property <string> caption;
    in property <image> icon;
    in property <int> target;
    label: root.caption + ": " + root.value;
    min-width: 0px;
    horizontal-stretch: 1;
    height: 60px;
    border-radius: Theme.radius-small;
    resting-background: Theme.surface;
    resting-border: Theme.edge;
    available: true;
    activated => { Store.open(root.target, 0); }
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 10px;
        Icon { source: root.icon; width: 18px; height: 18px; y: (parent.height - self.height) / 2; tone: Theme.protected-ink; }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1; min-width: 0px;
            Text { text: root.value; font-size: 18px; font-weight: 700; color: Theme.ink; overflow: elide; }
            Text { text: root.caption; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        Icon { source: Icons.chevron; width: 12px; height: 12px; y: (parent.height - self.height) / 2; tone: Theme.muted; }
    }
}

// A decision that lives on another page, with one step to get there.
component AttentionLine inherits Rectangle {
    in property <AttentionCard> data;
    height: 44px;
    border-radius: Theme.radius-small;
    background: root.data.kind == "alert" ? Theme.blush-soft : root.data.kind == "review" ? Theme.amber-soft : Theme.sky-soft;
    accessible-role: AccessibleRole.text;
    accessible-label: root.data.label + ": " + root.data.count + ", " + root.data.title + ". " + root.data.detail;
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; spacing: 10px;
        HorizontalLayout { width: 150px; alignment: start; StatusChip { width: 150px; constrained: true; label: root.data.label; kind: root.data.kind; y: (parent.height - self.height) / 2; } }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1; min-width: 0px;
            Text { text: root.data.count + " · " + root.data.title; font-size: 12px; font-weight: 700; color: Theme.ink; overflow: elide; }
            Text { text: root.data.detail; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        UiButton { y: (parent.height - self.height) / 2; small: true; label: root.data.action; available: true; activated => { Store.open(root.data.page, root.data.tab); } }
    }
}

component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    vertical-stretch: 1; alignment: center; spacing: 8px; padding: 16px;
    Text { text: root.title; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; wrap: word-wrap; }
    if root.text != "" : Text { text: root.text; font-size: 12px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
    @children
}

export component OverviewPage inherits VerticalLayout {
    min-width: 0px;
    preferred-width: 0px;
    spacing: Theme.gap;
    HorizontalLayout {
        spacing: 12px;
        PageHeader { horizontal-stretch: 1; title: "Übersicht"; }
        Text { text: Store.last-scan; max-width: 220px; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
    }
    HorizontalLayout {
        spacing: 10px;
        FigureTile { value: Store.project-count; caption: "Projekte"; icon: Icons.folder; target: 1; }
        FigureTile { value: Store.package-count; caption: "Paketversionen"; icon: Icons.package; target: 2; }
        FigureTile { value: Store.ai-count; caption: "KI-Dateien"; icon: Icons.spark; target: 3; }
        FigureTile { value: Store.storage-total; caption: Store.storage-caption; icon: Icons.drive; target: 4; }
    }
    if Store.attention.length > 0 : VerticalLayout {
        spacing: 6px;
        for card in Store.attention : AttentionLine { data: card; }
    }
    Card {
        vertical-stretch: 1;
        min-height: 100px;
        VerticalLayout {
            padding: 8px; spacing: 4px;
            HorizontalLayout {
                spacing: 6px; padding-left: 4px; alignment: start;
                FilterChip { label: "Prüfhinweise"; count: Store.review-count; selected: Store.overview-tab == 0; activated => { Store.overview-tab = 0; } }
                changes-tab := FilterChip { label: "Letzte Änderungen"; count: Store.events.length; selected: Store.overview-tab == 1; activated => { Store.overview-tab = 1; } }
                if Store.plans.length > 0 : FilterChip { label: "Bereinigungspläne"; count: Store.plans.length; selected: Store.overview-tab == 2; activated => { Store.overview-tab = 2; } }
            }
            if Store.overview-tab == 0 && Store.hints.length == 0 && Store.project-count == "0" : EmptyState {
                title: "Noch keine Projekte.";
                text: "Füge einen Projektordner hinzu oder lass mogumogu unter „Speicher“ ein ganzes Laufwerk nach Projekten durchsuchen – nur nach Namen. Danach erscheint hier, was eine Prüfung verdient.";
                HorizontalLayout {
                    alignment: center; spacing: 8px;
                    UiButton { primary: true; label: "Projekt hinzufügen"; available: !Store.demo && !Store.busy; activated => { Actions.guide-start(); } }
                    UiButton { label: "Laufwerk durchsuchen"; available: !Store.demo; activated => { Store.open(4, 0); } }
                }
            }
            if Store.overview-tab == 0 && Store.hints.length == 0 && Store.project-count != "0" : EmptyState {
                title: "Gerade braucht nichts deine Aufmerksamkeit.";
                text: "Neue Prüfhinweise erscheinen hier nach der nächsten Erfassung.";
            }
            if Store.overview-tab == 0 && Store.hints.length > 0 : ListView {
                vertical-stretch: 1;
                for hint in Store.hints : RowCard {
                    selection-kind: "hint";
                    selection-key: "" + hint.id + "|" + hint.kind;
                    icon: hint.kind == "Prüftermin erreicht" ? Icons.clock : hint.kind == "Möglicherweise verwaist" ? Icons.folder : Icons.package;
                    title: hint.name + " · " + hint.kind;
                    subtitle: hint.trigger != "" ? hint.trigger : hint.evidence;
                    meta: hint.size;
                    pill: hint.protected ? "Geschützt" : "Prüfen";
                    pill-kind: hint.protected ? "protected" : "review";
                    label: hint.name + ", " + hint.kind;
                    activated => { Actions.open-hint(hint.id); }
                }
            }
            if Store.overview-tab == 1 && Store.events.length == 0 : EmptyState {
                title: "Noch keine Änderungen.";
                text: "Erfassungen und Freigaben erscheinen hier.";
            }
            if Store.overview-tab == 1 && Store.events.length > 0 : ListView {
                vertical-stretch: 1;
                for event in Store.events : RowCard {
                    interactive: false; accessible-role: text;
                    icon: Icons.history;
                    title: event.title;
                    subtitle: event.detail;
                    meta: event.time;
                }
            }
            if Store.overview-tab == 2 : ListView {
                vertical-stretch: 1;
                for plan in Store.plans : RowCard {
                    selection-kind: "plan";
                    selection-key: "" + plan.id;
                    icon: Icons.check;
                    title: "Plan " + plan.id + " · " + plan.summary;
                    subtitle: plan.created;
                    pill: plan.state;
                    pill-kind: "protected";
                    label: "Plan " + plan.id;
                    activated => { Actions.open-plan(plan.id); }
                }
            }
        }
    }
}
