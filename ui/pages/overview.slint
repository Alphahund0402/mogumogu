import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions, AttentionCard } from "../store.slint";
import { Card, CardTitle, Icon, UiButton, FilterChip, Legend, SegmentBar, StatusChip, ProjectTable, PageHeader } from "../components.slint";

// One trigger with its count and the next step; never a verdict.
component AttentionTile inherits Card {
    in property <AttentionCard> data;
    min-width: 240px;
    preferred-width: 260px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 12px; padding-left: 14px; padding-right: 14px; spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.data.title; font-size: 12.5px; font-weight: 700; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
            Text { text: root.data.count; font-size: 20px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
        }
        Text { text: root.data.detail; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        FlexboxLayout {
            alignment: start; padding-top: 3px; spacing: 6px;
            StatusChip { label: root.data.label; kind: root.data.kind; }
            UiButton { small: true; label: root.data.action; available: true; activated => { Store.page = root.data.page; } }
        }
    }
}

component CalmTile inherits Card {
    horizontal-stretch: 1;
    HorizontalLayout {
        padding: 14px; spacing: 12px;
        Icon { source: Icons.check; width: 20px; height: 20px; y: (parent.height - self.height) / 2; tone: Theme.ok-ink; }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: Store.project-count == "0" ? "Noch nichts zu prüfen." : "Gerade braucht nichts deine Aufmerksamkeit."; font-size: 13px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
            Text { text: "Keine offenen Prüfhinweise oder hängenden Sessions. Ungeklärte Nutzung bleibt unbekannt."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
        }
    }
}

component ProjectsPane inherits Card {
    VerticalLayout {
        spacing: 2px;
        FlexboxLayout {
            padding-left: 14px; padding-right: 10px; padding-top: 8px; padding-bottom: 4px; spacing: 4px;
            alignment: start;
            Text { text: "Projekte"; font-size: 13.5px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
            FilterChip { label: "Alle"; count: Store.count-all; selected: Store.filter == 0; activated => { Store.filter = 0; Actions.filter-projects(); } }
            FilterChip { label: "Belegt"; count: Store.count-observed; selected: Store.filter == 1; activated => { Store.filter = 1; Actions.filter-projects(); } }
            FilterChip { label: "Prüfen"; count: Store.count-review; selected: Store.filter == 2; activated => { Store.filter = 2; Actions.filter-projects(); } }
            FilterChip { label: "Unbekannt"; count: Store.count-unknown; selected: Store.filter == 3; activated => { Store.filter = 3; Actions.filter-projects(); } }
        }
        ProjectTable { rows: Store.projects; compact: true; vertical-stretch: 1; selected(id) => { Actions.open-project(id); } }
    }
}

export component OverviewPage inherits ScrollView {
    min-width: 0px;
    preferred-width: 0px;
    content-width: self.visible-width;
    property <bool> compact: Store.window-width < 1012px;
    property <bool> two-tiles: Store.window-width < 1200px;
    property <length> content-size: Store.window-width - 232px;
    VerticalLayout {
    padding-right: 16px; padding-bottom: 12px;
    spacing: Theme.gap;
    header := HorizontalLayout {
        spacing: 12px;
        PageHeader {
            horizontal-stretch: 1;
            title: "Übersicht";
            description: "Offene Hinweise, Projekte und Speicher. Hinweise sind keine Löschfreigabe.";
        }
        Text { text: Store.last-scan; max-width: 180px; font-size: 11px; color: Theme.muted; vertical-alignment: bottom; wrap: word-wrap; }
    }
    attention := GridLayout {
        spacing: Theme.gap;
        if Store.attention.length == 0 : CalmTile { row: 0; col: 0; }
        // The service exposes at most three priority cards. Explicit grid
        // rows make wrapped text contribute its full height to the page.
        if Store.attention.length > 0 : AttentionTile {
            row: 0; col: 0; data: Store.attention[0];
            width: root.two-tiles ? (root.content-size - Theme.gap) / 2 : (root.content-size - 2 * Theme.gap) / 3;
        }
        if Store.attention.length > 1 : AttentionTile {
            row: 0; col: 1; data: Store.attention[1];
            width: root.two-tiles ? (root.content-size - Theme.gap) / 2 : (root.content-size - 2 * Theme.gap) / 3;
        }
        if Store.attention.length > 2 : AttentionTile {
            row: root.two-tiles ? 1 : 0; col: root.two-tiles ? 0 : 2;
            colspan: root.two-tiles ? 2 : 1; data: Store.attention[2];
            width: root.two-tiles ? root.content-size : (root.content-size - 2 * Theme.gap) / 3;
        }
    }
    GridLayout {
        spacing: Theme.gap;
        ProjectsPane {
            row: 0; col: 0;
            horizontal-stretch: 1; min-width: 0px;
            min-height: 260px;
            preferred-height: 320px;
        }
        GridLayout {
            row: root.compact ? 1 : 0; col: root.compact ? 0 : 1;
            width: root.compact ? Store.window-width - 232px : 244px;
            spacing: Theme.gap;
            Card {
                row: 0; col: 0;
                width: root.compact ? (root.content-size - Theme.gap) / 2 : 244px;
                VerticalLayout {
                    CardTitle { title: "Abdeckung"; eyebrow: Store.coverage-caption; }
                    VerticalLayout {
                        padding-left: 14px; padding-right: 14px; padding-bottom: 12px; spacing: 8px;
                        SegmentBar { rows: Store.coverage-rows; }
                        Legend { rows: Store.coverage-rows; }
                    }
                }
            }
            Card {
                row: root.compact ? 0 : 1; col: root.compact ? 1 : 0;
                width: root.compact ? (root.content-size - Theme.gap) / 2 : 244px;
                VerticalLayout {
                    CardTitle { title: "Speicher"; eyebrow: Store.donut-value; }
                    VerticalLayout {
                        padding-left: 14px; padding-right: 14px; padding-bottom: 12px; spacing: 8px; alignment: start;
                        SegmentBar { rows: Store.legend; }
                        Legend { rows: Store.legend; }
                        Text { text: Store.storage-subtitle; wrap: word-wrap; font-size: 11px; color: Theme.muted; }
                        HorizontalLayout {
                            alignment: start;
                            UiButton { small: true; quiet: true; label: "Laufwerke öffnen"; activated => { Store.page = 10; } }
                        }
                    }
                }
            }
        }
    }
    }
}
