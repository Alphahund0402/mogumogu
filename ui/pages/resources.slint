import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions } from "../store.slint";
import { UiButton, FilterChip, RowCard } from "../components.slint";
import { PageCard } from "page-card.slint";
import { DiscoveryFilters, DiscoveryList } from "discoveries.slint";

export component ResourcesPage inherits PageCard {
    title: "Ressourcen";
    description: "Zuordnung, Größe und Nutzung deiner Entwicklungsdateien. Ohne Messung bleibt die Größe unbekannt; Lesen braucht eine Freigabe.";
    FlexboxLayout {
        spacing: 6px; alignment: start;
        FilterChip { label: "Registriert"; selected: Store.resource-tab == 0; activated => { Store.resource-tab = 0; Actions.filter-resources(); } }
        FilterChip { label: "Scratchpads"; selected: Store.resource-tab == 1; activated => { Store.resource-tab = 1; Actions.filter-resources(); } }
        FilterChip { label: "Fundliste"; selected: Store.resource-tab == 2; activated => { Store.resource-tab = 2; Actions.filter-candidates(); } }
        FilterChip { label: "Umgebungen & Ausgaben"; selected: Store.resource-tab == 3; activated => { Store.resource-tab = 3; } }
        UiButton { small: true; label: "Experimente öffnen"; has-icon: true; icon: Icons.flask; available: true; activated => { Store.page = 4; } }
    }
    if Store.resource-tab < 2 && Store.resources.length == 0 : VerticalLayout {
        vertical-stretch: 1; alignment: center; spacing: 8px; padding: 16px;
        Text { text: Store.resource-tab == 1 ? "Noch keine Scratchpads angelegt." : "Noch keine Ressourcen registriert."; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: Store.resource-tab == 1 ? "Ein Experiment bündelt Scratchpad, Zweck und Nutzung." : "Ordne einen Eintrag aus der Fundliste einem Projekt zu."; font-size: 12px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center;
            UiButton { small: true; label: Store.resource-tab == 1 ? "Experimente öffnen" : "Fundliste öffnen"; available: true; activated => { if Store.resource-tab == 1 { Store.page = 4; } else { Store.resource-tab = 2; Actions.filter-candidates(); } } }
        }
    }
    if Store.resource-tab < 2 && Store.resources.length > 0 : ListView {
        vertical-stretch: 1;
        for row in Store.resources : RowCard {
            selection-kind: "resource";
            selection-key: "" + row.id;
            icon: row.kind == "Temporär" ? Icons.clock : row.kind == "Umgebung" ? Icons.package : Icons.folder;
            title: row.name;
            subtitle: row.kind + " · " + row.owner + (row.detail != "" ? " · " + row.detail : "");
            meta: row.size;
            pill: row.state;
            pill-kind: row.state-kind;
            label: row.name;
            activated => { Actions.open-resource(row.id); }
        }
    }
    if Store.resource-tab == 3 && Store.artifacts.length > 0 : ListView {
        vertical-stretch: 1;
        for artifact in Store.artifacts : RowCard {
            icon: Icons.drive;
            title: artifact.name; subtitle: artifact.owner + " · " + artifact.detail;
            meta: artifact.size; pill: artifact.state; pill-kind: "protected";
            selection-kind: "artifact"; selection-key: "" + artifact.id;
            activated => { Actions.open-artifact(artifact.id); }
        }
    }
    if Store.resource-tab == 2 : DiscoveryFilters { }
    if Store.resource-tab == 2 : DiscoveryList { }
    if Store.resource-tab == 3 && Store.artifacts.length == 0 : VerticalLayout {
        vertical-stretch: 1; alignment: center; spacing: 8px; padding: 16px;
        Text { text: "Noch keine Umgebungen, Ausgaben oder Caches erkannt."; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: "Freigegebene Bereiche erfassen. Unbekannte Inhalte bleiben geschützt."; font-size: 12px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
    }
}
