import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Store, Actions } from "../store.slint";
import { Card, RowCard, PageHeader, FilterChip, UiButton } from "../components.slint";

export component ActivityPage inherits VerticalLayout {
    spacing: Theme.gap;
    property <bool> show-events: false;
    PageHeader {
        title: "Aktivität & Abdeckung";
        description: "Lesefreigaben, Erfassungsstand und Änderungen. Teilweise erfasst heißt nicht vollständig bekannt.";
    }
    FlexboxLayout {
        spacing: 6px; alignment: start;
        FilterChip { label: "Lesefreigaben"; count: "" + Store.scopes.length; selected: !root.show-events; activated => { root.show-events = false; } }
        events-toggle := FilterChip { label: "Ereignisse"; count: "" + Store.events.length; selected: root.show-events; activated => { root.show-events = true; } }
    }
    if !root.show-events : Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 6px;
            if Store.scopes.length == 0 : VerticalLayout {
                padding: 10px; spacing: 10px; alignment: start;
                Text { text: "Noch keine Lesefreigaben. Wähle einen Projektordner oder einen Systembestand."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: start;
                    UiButton { small: true; label: "Projekt hinzufügen"; activated => { Actions.guide-start(); } }
                    UiButton { small: true; label: "System öffnen"; activated => { Store.page = 6; } }
                }
            }
            ListView {
                vertical-stretch: 1;
                for scope in Store.scopes : RowCard {
                    selection-kind: "scope";
                    selection-key: "" + scope.id;
                    icon: scope.watched ? Icons.monitor : Icons.shield;
                    title: scope.path;
                    subtitle: scope.kind + " · " + scope.coverage + (scope.watched ? " · wird beobachtet" : "");
                    meta: scope.last;
                    pill: scope.status;
                    pill-kind: scope.healthy ? "ok" : "warn";
                    activated => { Actions.open-scope(scope.id); }
                }
            }
        }
    }
    if root.show-events : Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 6px;
            if Store.events.length == 0 : HorizontalLayout {
                padding: 10px;
                Text { text: "Noch keine Ereignisse. Erfassungen und Änderungen erscheinen hier."; font-size: 11.5px; color: Theme.muted; wrap: word-wrap; }
            }
            ListView {
                vertical-stretch: 1;
                for event in Store.events : RowCard {
                    interactive: false; accessible-role: text;
                    icon: Icons.activity;
                    title: event.title;
                    subtitle: event.detail;
                    meta: event.time;
                }
            }
        }
    }
}
