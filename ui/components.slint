import { Switch, ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Store, Actions, ProjectRow, DonutSegment, LegendRow } from "store.slint";

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #16354f0a;
}

export component Icon inherits Image {
    in property <color> tone: Theme.ink;
    width: 18px;
    height: 18px;
    colorize: root.tone;
    image-fit: contain;
    accessible-role: none;
}

// Keyboard-activatable surface: Enter/Space trigger, focus ring visible.
// Disabled while a dialog is open unless the element lives in the dialog.
export component Activatable inherits Rectangle {
    in property <bool> available: true;
    in property <bool> in-dialog: false;
    in property <string> label;
    in property <string> selection-kind;
    in property <string> selection-key;
    in property <bool> selected: root.selection-kind != "" && Store.selection-kind == root.selection-kind && Store.selection-key == root.selection-key;
    in property <bool> checkable: false;
    in property <brush> resting-background: transparent;
    in property <color> resting-border: transparent;
    in property <color> focus-color: Theme.focus;
    out property <bool> hovered: touch.has-hover && root.active;
    out property <bool> pressed: touch.pressed && root.active;
    out property <bool> focused: focus.has-focus && root.active;
    property <bool> active: root.available && (Store.modal == 0 || root.in-dialog);
    callback activated();
    forward-focus: focus;
    border-width: 1px;
    border-color: root.selected ? Theme.selected-border : root.hovered ? Theme.hover-border : root.resting-border;
    background: !root.available ? Theme.disabled
        : root.selected ? (root.pressed ? Theme.selected-pressed : root.hovered ? Theme.selected-hover : Theme.selected)
        : root.pressed ? Theme.pressed : root.hovered ? Theme.hover : root.resting-background;
    public function grab-focus() { focus.focus(); }
    public function trigger() {
        if root.active {
            if root.selection-kind != "" {
                Store.selection-kind = root.selection-kind;
                Store.selection-key = root.selection-key;
            }
            root.activated();
        }
    }
    accessible-role: button;
    accessible-label: root.label + (root.selected ? ", ausgewählt" : "");
    accessible-enabled: root.active;
    accessible-checkable: root.checkable;
    accessible-checked: root.selected;
    accessible-action-default => { root.trigger(); }
    focus := FocusScope {
        width: root.width; height: root.height;
        enabled: root.active;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.trigger(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        width: root.width; height: root.height;
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.trigger(); }
    }
    @children
    if root.selected && root.selection-kind != "" : Rectangle {
        x: 1px; y: 8px; width: 3px; height: root.height - 16px;
        border-radius: 2px; background: Theme.blue;
        accessible-role: none;
    }
    // Inset and explicitly bound to this control: no layout expansion or
    // clipping into adjacent rows, including virtualized ListView items.
    if root.focused : Rectangle {
        border-radius: max(0px, root.border-radius - 2px);
        border-width: 2px;
        border-color: root.focus-color;
        x: 3px; y: 3px; width: root.width - 6px; height: root.height - 6px;
        accessible-role: none;
    }
}

export component UiButton inherits Activatable {
    available: !Store.busy;
    in property <bool> primary: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> font-size: 11px;
    focus-color: root.primary ? white : Theme.focus;
    height: 32px;
    min-width: 72px;
    border-radius: 7px;
    border-width: 1px;
    resting-background: Theme.surface;
    resting-border: #d3deea;
    border-color: !root.available ? Theme.line : root.primary ? Theme.blue : root.selected ? Theme.selected-border : root.hovered ? Theme.hover-border : root.resting-border;
    background: !root.available ? Theme.disabled
        : root.primary ? (root.pressed ? Theme.blue-pressed : root.hovered ? Theme.blue-hover : Theme.blue)
        : root.selected ? (root.pressed ? Theme.selected-pressed : root.hovered ? Theme.selected-hover : Theme.selected)
        : root.pressed ? Theme.pressed : root.hovered ? Theme.hover : root.resting-background;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 7px; alignment: center;
        if root.has-icon : Icon { source: root.icon; width: 13px; height: 13px; y: (parent.height - self.height) / 2; tone: !root.available ? Theme.disabled-ink : root.primary ? white : root.selected ? Theme.selected-ink : Theme.ink; }
        Text {
            text: root.label;
            font-size: root.font-size;
            vertical-alignment: center;
            color: !root.available ? Theme.disabled-ink : root.primary ? white : root.selected ? Theme.selected-ink : Theme.ink;
            font-weight: root.selected || root.primary ? 600 : 400;
        }
    }
}

export component NavItem inherits Activatable {
    in property <image> icon;
    checkable: true;
    height: 42px;
    border-radius: 8px;
    if root.selected : Rectangle { x: 1px; y: 10px; width: 3px; height: root.height - 20px; border-radius: 2px; background: Theme.blue; }
    HorizontalLayout {
        padding-left: 13px; spacing: 12px;
        Icon { source: root.icon; y: (parent.height - self.height) / 2; tone: root.selected ? Theme.selected-ink : Theme.ink; }
        Text { text: root.label; vertical-alignment: center; font-size: 12px; color: root.selected ? Theme.selected-ink : Theme.ink; font-weight: root.selected ? 650 : 400; }
    }
}

export component Metric inherits Activatable {
    in property <string> value;
    in property <string> caption;
    in property <string> note;
    in property <image> icon;
    in property <color> tone: Theme.blue;
    in property <color> tint: #edf4ff;
    min-height: 96px;
    resting-background: Theme.surface;
    border-radius: Theme.radius;
    resting-border: Theme.line;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #16354f0a;
    accessible-label: root.value + " " + root.caption + ". " + root.note;
    HorizontalLayout {
        padding-left: 16px; padding-right: 12px; spacing: 15px; alignment: start;
        Rectangle {
            width: 44px; height: 44px; y: (parent.height - self.height) / 2; border-radius: 12px; background: root.tint;
            Icon { source: root.icon; width: 25px; height: 25px; tone: root.tone; }
        }
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text { text: root.value; font-size: 24px; font-weight: 720; color: Theme.ink; }
            Text { text: root.caption; font-size: 11px; color: #6d7f93; }
            Text { text: root.note; font-size: 9px; color: root.tone; overflow: elide; }
        }
    }
}

export component CardTitle inherits HorizontalLayout {
    in property <string> title;
    in property <string> eyebrow;
    padding-left: 17px; padding-right: 17px; padding-top: 14px; height: 38px;
    Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
    if root.eyebrow != "" : Text { text: root.eyebrow; font-size: 7px; font-weight: 650; letter-spacing: 0.8px; color: Theme.muted; vertical-alignment: center; }
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <string> kind;
    height: 21px;
    min-width: 62px;
    border-radius: 5px;
    background: root.kind == "observed" || root.kind == "ok" ? #e7f7ef
        : root.kind == "review" || root.kind == "warn" ? Theme.amber-soft
        : root.kind == "protected" ? #edf3fc
        : root.kind == "running" ? #e5efff
        : root.kind == "danger" ? #fde8e8 : #f0f3f7;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        Text {
            text: root.label;
            font-size: 9px;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: root.kind == "observed" || root.kind == "ok" ? #1b8b67
                : root.kind == "review" || root.kind == "warn" ? Theme.amber
                : root.kind == "protected" ? #6080a1
                : root.kind == "running" ? Theme.blue
                : root.kind == "danger" ? #b23b3b : #7b899b;
        }
    }
}

export component FilterChip inherits Activatable {
    in property <string> count;
    checkable: true;
    height: 30px;
    border-radius: 6px;
    resting-background: Theme.row;
    resting-border: Theme.line;
    accessible-label: root.label + " " + root.count + (root.selected ? ", aktiv" : "");
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 6px;
        if root.selected : Icon { source: Icons.check; width: 12px; height: 12px; y: (parent.height - self.height) / 2; tone: Theme.selected-ink; }
        Text { text: root.label; font-size: 10px; font-weight: root.selected ? 650 : 400; vertical-alignment: center; color: root.selected ? Theme.selected-ink : Theme.muted; }
        if root.count != "" : Text { text: root.count; font-size: 9px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; color: root.selected ? Theme.selected-ink : Theme.muted; }
    }
}

export component QuickAction inherits Activatable {
    in property <string> subtitle;
    in property <image> icon;
    height: 50px;
    border-radius: 8px;
    resting-border: Theme.line;
    resting-background: Theme.row;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        Icon { source: root.icon; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.label; font-size: 10px; color: Theme.ink; }
            Text { text: root.subtitle; font-size: 8px; color: Theme.muted; overflow: elide; }
        }
        Icon { source: Icons.chevron; width: 12px; height: 12px; y: (parent.height - self.height) / 2; tone: #8191a3; }
    }
}

export component RowCard inherits Activatable {
    in property <string> title;
    in property <string> subtitle;
    in property <string> meta;
    in property <string> pill;
    in property <string> pill-kind;
    in property <image> icon;
    height: 62px;
    border-radius: 9px;
    resting-border: Theme.line;
    resting-background: Theme.row;
    accessible-label: root.title + ". " + root.subtitle + ". " + root.pill + (root.selected ? ", ausgewählt" : "");
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 14px;
        Icon { source: root.icon; y: (parent.height - self.height) / 2; tone: root.selected ? Theme.selected-ink : #6585a0; }
        VerticalLayout {
            alignment: center; spacing: 4px; horizontal-stretch: 1;
            Text { text: root.title; font-size: 12px; font-weight: root.selected ? 700 : 600; color: root.selected ? Theme.selected-ink : Theme.ink; overflow: elide; }
            Text { text: root.subtitle; font-size: 10px; color: Theme.muted; overflow: elide; }
        }
        if root.meta != "" : Text { text: root.meta; font-size: 12px; color: #49617b; vertical-alignment: center; }
        if root.pill != "" : Pill { label: root.pill; kind: root.pill-kind; y: (parent.height - self.height) / 2; }
    }
}

export component Callout inherits Rectangle {
    in property <string> text;
    in property <bool> warn: false;
    in property <image> icon: Icons.info;
    min-height: 46px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.warn ? #f5e6c9 : #dceaf9;
    background: root.warn ? #fff8ed : #edf5fd;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding: 14px; spacing: 10px;
        Icon { source: root.icon; width: 16px; height: 16px; tone: root.warn ? #987340 : #496c92; }
        Text { text: root.text; wrap: word-wrap; font-size: 11px; color: root.warn ? #987340 : #496c92; horizontal-stretch: 1; vertical-alignment: center; }
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    Text { text: root.title; font-size: 22px; font-weight: 700; color: Theme.ink; accessible-role: AccessibleRole.text; }
    Text { text: root.description; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
}

export component Donut inherits Rectangle {
    in property <[DonutSegment]> segments;
    in property <string> value;
    in property <string> caption;
    width: 166px;
    height: 166px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.value + " " + root.caption;
    if root.segments.length == 0 : Rectangle {
        border-radius: self.width / 2; border-width: 19px; border-color: Theme.line;
    }
    for segment in root.segments : Path {
        width: parent.width; height: parent.height;
        viewbox-width: 100; viewbox-height: 100;
        commands: segment.commands;
        fill: segment.color;
        stroke-width: 0px;
    }
    VerticalLayout {
        alignment: center;
        Text { text: root.value; font-size: 21px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; }
        Text { text: root.caption; font-size: 8px; color: Theme.muted; horizontal-alignment: center; }
    }
}

export component Legend inherits VerticalLayout {
    in property <[LegendRow]> rows;
    spacing: 10px;
    alignment: center;
    for row in root.rows : HorizontalLayout {
        spacing: 7px;
        Rectangle { width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 4px; background: row.color; }
        Text { text: row.label; font-size: 9px; color: Theme.ink; horizontal-stretch: 1; vertical-alignment: center; }
        Text { text: row.value; font-size: 9px; color: #6f8196; vertical-alignment: center; horizontal-alignment: right; }
    }
}

// Light grey settings card; its height follows its content.
export component Panel inherits Rectangle {
    in property <string> title;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.row;
    VerticalLayout {
        padding: 18px; spacing: 8px; alignment: start;
        Text { text: root.title; font-size: 13px; font-weight: 700; color: Theme.ink; }
        @children
    }
}

export component SettingToggle inherits Panel {
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    background: root.checked ? Theme.selected : Theme.row;
    border-color: root.checked ? Theme.selected-border : Theme.line;
    callback toggled(bool);
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.description; font-size: 11px; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
        Switch {
            checked: root.checked;
            enabled: root.enabled && Store.modal == 0 && !Store.busy;
            text: root.checked ? "Ein" : "Aus";
            accessible-label: root.title;
            toggled => { root.toggled(self.checked); }
        }
    }
}

component ProjectLine inherits Activatable {
    in property <ProjectRow> data;
    height: 40px;
    border-radius: 6px;
    selection-kind: "project";
    selection-key: "" + root.data.id;
    label: root.data.name + ", " + root.data.state + ", " + root.data.path;
    Rectangle { y: parent.height - 1px; height: 1px; background: #edf2f6; visible: !root.selected; }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        HorizontalLayout {
            width: 150px; spacing: 8px;
            Icon { source: Icons.folder; width: 14px; height: 14px; y: (parent.height - self.height) / 2; tone: root.selected ? Theme.selected-ink : Theme.blue; }
            Text { text: root.data.name; font-size: 10px; font-weight: root.selected ? 650 : 500; color: root.selected ? Theme.selected-ink : Theme.ink; vertical-alignment: center; overflow: elide; }
        }
        Text { text: root.data.path; horizontal-stretch: 1; font-size: 9px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
        Text { text: root.data.size; width: 72px; font-size: 10px; color: Theme.ink; vertical-alignment: center; }
        HorizontalLayout { width: 92px; alignment: start; Pill { label: root.data.state; kind: root.data.state-kind; y: (parent.height - self.height) / 2; } }
        Text { text: root.data.ecosystem; width: 130px; font-size: 9px; color: #6f8197; vertical-alignment: center; overflow: elide; }
    }
}

export component ProjectTable inherits Rectangle {
    in property <[ProjectRow]> rows;
    in property <bool> compact: false;
    callback selected(int);
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 30px; border-radius: 6px; background: #f7f9fc;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 10px;
                Text { text: "PROJEKT"; width: 150px; font-size: 8px; color: #7b8a9d; vertical-alignment: center; }
                Text { text: "PFAD"; horizontal-stretch: 1; font-size: 8px; color: #7b8a9d; vertical-alignment: center; }
                Text { text: "GRÖSSE"; width: 72px; font-size: 8px; color: #7b8a9d; vertical-alignment: center; }
                Text { text: "BEOBACHTUNG"; width: 92px; font-size: 8px; color: #7b8a9d; vertical-alignment: center; }
                Text { text: "TECHNOLOGIE"; width: 130px; font-size: 8px; color: #7b8a9d; vertical-alignment: center; }
            }
        }
        if root.rows.length == 0 : VerticalLayout {
            padding: 16px; spacing: 10px; alignment: center;
            Text {
                text: Store.project-count == "0" ? "Noch keine Projekte registriert. Beginne mit einem Projektordner." : "Keine Projekte passen zur Suche und zum Filter.";
                font-size: 11px; color: Theme.muted; wrap: word-wrap; horizontal-alignment: center;
                accessible-role: text;
            }
            HorizontalLayout {
                alignment: center;
                if Store.project-count == "0" : UiButton {
                    label: "Projekt registrieren";
                    activated => { Actions.new-project(); }
                }
                if Store.project-count != "0" : UiButton {
                    label: "Suche und Filter zurücksetzen";
                    activated => { Store.query = ""; Store.filter = 0; Actions.filter-projects(); }
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for row in root.rows : ProjectLine { data: row; activated => { root.selected(row.id); } }
        }
    }
}
