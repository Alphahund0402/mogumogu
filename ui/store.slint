// The only interface between Rust and the UI: data in `Store`, intents in
// `Actions`. Pages read from Store and call Actions; no page knows Rust.

export struct ProjectRow { id: int, name: string, path: string, ecosystem: string, state: string, state-kind: string, size: string, detail: string, approved: bool, coverage: string, coverage-kind: string }
export struct ResourceRow { id: int, name: string, kind: string, owner: string, size: string, state: string, state-kind: string, detail: string }
export struct AiRow { index: int, client: string, kind: string, detail: string, path: string, letter: string, references: int, scope: string }
export struct EventRow { title: string, detail: string, time: string, kind: string }
export struct AdapterRow { id: string, name: string, inventory: string, updates: string, cleanup: string, counts: string, formats: string, limits: string }
export struct HintRow { id: int, name: string, kind: string, trigger: string, evidence: string, size: string, protected: bool, plannable: bool, stalled: bool }
export struct ScopeRow { id: int, kind: string, path: string, status: string, coverage: string, last: string, watched: bool, healthy: bool }
export struct SessionRow { id: int, scratch: string, scratch-id: int, purpose: string, state: string, state-kind: string, started: string, stall: string, releasable: bool, note: string }
export struct PlanRow { id: int, state: string, created: string, summary: string, fingerprint: string }
export struct DonutSegment { commands: string, color: color }
export struct LegendRow { label: string, value: string, color: color, share: float }
export struct ProfileChip { name: string, status: string }
export struct DetailRow { label: string, value: string }
export struct DetailAction { id: string, label: string, primary: bool }
export struct SourceToggle { host: string, enabled: bool }
export struct PackageRow { key: string, name: string, version: string, source: string, upstream: string, upstream-kind: string, references: string, update: string, review: bool, kept: bool }
export struct CandidateRow { index: int, path: string, evidence: string, status: string }
// Attention cards of the overview: one trigger, its count and the next step.
export struct AttentionCard { kind: string, label: string, count: string, title: string, detail: string, action: string, page: int }
// One metadata-only system finding; `approvable` offers a read approval.
export struct SystemRow { id: string, name: string, location: string, evidence: string, evidence-kind: string, note: string, approvable: bool, approved: bool, coverage: string, scope-id: int }
// One hit of the global search.
export struct SearchRow { area: string, area-label: string, key: string, title: string, detail: string }
// A scratchpad as an experiment, with the state of its sessions.
export struct ExperimentRow { id: int, name: string, project: string, purpose: string, state: string, state-kind: string }
// What finishing an experiment would do to one managed folder.
export struct FolderRow { name: string, size: string, fate: string, fate-kind: string }
export struct ChainStep { label: string, detail: string, warn: bool }
export struct DriveRow { root: string, label: string, kind: string, total: string, used: string, free: string, projects: string, usage: float, project-share: float, note: string }
export struct DiskProjectRow { id: int, name: string, path: string, drive: string, size: string, share: string, fraction: float, scope-id: int, note: string }
export struct TreeScopeRow { id: int, label: string, path: string }
export struct TreeRow { index: int, name: string, path: string, size: string, is-dir: bool, note: string }

export global Store {
    // Set imperatively by the window; layouts read it without a binding loop.
    in-out property <length> window-width: 1080px;
    // Mode and status
    in property <bool> demo: false;
    in property <bool> busy: false;
    in property <string> status: "Inventar wird geladen …";
    in property <string> sqlite-version;
    in property <string> data-path;
    in property <string> version: "0.1.0";
    in property <string> last-scan;
    in property <string> monitoring-text;

    // Mochi: pose 0 neutral, 1 happy, 2 folder, 3 laptop, 4 munching, 5 sleeping, 6 worried
    in property <int> mascot-pose: 1;
    in property <string> mascot-line;
    in property <string> mascot-caption;

    // Overview
    in property <string> project-count: "0";
    in property <string> package-count: "—";
    in property <string> footprint: "—";
    in property <string> ai-count: "0";
    in property <int> review-count: 0;
    in property <string> count-all: "0";
    in property <string> count-observed: "0";
    in property <string> count-review: "0";
    in property <string> count-unknown: "0";
    in property <[AttentionCard]> attention;
    in property <[LegendRow]> coverage-rows;
    in property <string> coverage-caption;

    // Models (bounded by Rust to one UI page each)
    in property <[ProjectRow]> projects;
    in property <[ResourceRow]> resources;
    in property <[AiRow]> ai;
    in property <[EventRow]> events;
    in property <[AdapterRow]> adapters;
    in property <[HintRow]> hints;
    in property <[ScopeRow]> scopes;
    in property <[SessionRow]> sessions;
    in property <[PlanRow]> plans;
    in property <[ProfileChip]> profiles;
    in property <[PackageRow]> packages;
    in property <[CandidateRow]> candidates;
    in property <[ResourceRow]> artifacts;
    in property <string> ai-user-count: "0";
    in property <string> ai-project-count: "0";

    // Packages: page, filter, selection panel
    in property <string> package-coverage;
    in property <string> package-page-label;
    in property <int> package-offset;
    in property <int> package-page-size;
    in property <bool> package-previous;
    in property <bool> package-next;
    in-out property <int> package-tab: 0;
    in-out property <int> package-filter: 0;
    in-out property <string> package-search;
    in property <[string]> package-counts: ["0", "0", "0", "0", "0"];
    in property <bool> package-panel: false;
    in property <string> panel-title;
    in property <string> panel-source;
    in property <string> panel-status;
    in property <string> panel-status-kind;
    in property <[ChainStep]> panel-chain;
    in property <string> panel-advice;
    in property <string> panel-note;
    in property <bool> panel-kept;
    in property <string> panel-key;
    in-out property <bool> show-candidates: false;

    // Experiments
    in property <[ExperimentRow]> experiments;
    in property <int> experiment-id: -1;
    in property <string> experiment-name;
    in property <string> experiment-path;
    in property <string> experiment-review;
    in property <string> experiment-review-kind;
    in property <[SessionRow]> experiment-sessions;
    in property <[FolderRow]> experiment-folders;
    in property <string> experiment-stall;
    in property <bool> experiment-plannable;
    in property <int> stalled-count: 0;

    // System
    in property <[SystemRow]> system-tools;
    in property <[SystemRow]> system-stores;
    in property <[SystemRow]> system-ai;
    in property <string> system-checked;
    in property <int> system-suggestions: 0;

    // Storage overview
    in property <[DonutSegment]> donut;
    in property <[LegendRow]> legend;
    in property <string> donut-value: "—";
    in property <string> donut-caption: "Unbekannt";
    in property <string> storage-subtitle;
    in property <[DriveRow]> drives;
    in property <[DiskProjectRow]> disk-projects;
    in property <[TreeScopeRow]> tree-scopes;
    in property <string> disk-note;
    in property <string> disk-checked;
    in-out property <string> selected-drive;
    in property <int> tree-scope-id: -1;
    in property <string> tree-path;
    in property <string> tree-note: "Wähle einen freigegebenen Ordner, um seine Struktur zu öffnen.";
    in property <bool> tree-up: false;
    in property <bool> tree-loading: false;
    in property <[TreeRow]> tree-rows;
    in-out property <int> storage-tab: 0;
    in-out property <int> candidate-filter: 0;
    in-out property <string> candidate-search;

    // Settings
    in property <bool> monitoring: false;
    in property <bool> notifications: false;
    in property <bool> updates: false;
    in property <bool> guide-enabled: true;
    in property <bool> daily-summary: false;
    in property <int> summary-hour: 17;
    in property <bool> quiet-enabled: false;
    in property <int> quiet-from: 19;
    in property <int> quiet-to: 8;
    in property <bool> autostart: false;
    in property <bool> autostart-available: true;
    in property <string> autostart-note;
    in property <string> pause-text;
    in property <[SourceToggle]> sources;
    in property <string> scratch-root;
    in property <string> cleanup-status;

    // Scan progress and cancel
    in property <bool> scan-running: false;
    in property <bool> scan-cancelling: false;
    in property <float> scan-progress: 0;
    in property <string> scan-text;
    // Result of the last pass the user started; empty once closed or timed out.
    in-out property <string> scan-notice;
    in property <string> scan-notice-kind;

    // Guided start: 0 welcome, 1 folder, 2 approval, 3 scanning, 4 done
    in-out property <bool> guide-open: false;
    in-out property <int> guide-step: 0;
    in-out property <string> guide-path;
    in-out property <string> guide-name;
    in-out property <bool> guide-scan-now: true;
    in property <string> guide-error;
    in property <string> guide-result;

    // Global search
    in-out property <string> query;
    in property <[SearchRow]> search-results;
    in-out property <bool> search-open: false;

    // Navigation and filters
    in-out property <int> page: 0;
    in-out property <int> filter: 0;
    in-out property <int> resource-tab: 0;
    // Stable keys keep the last opened row visible across view/model rebuilds.
    in-out property <string> selection-kind;
    in-out property <string> selection-key;

    // Modal layer: 0 none, 1 detail, 2 form
    in-out property <int> modal: 0;
    in property <string> detail-title;
    in property <string> detail-path;
    in property <string> detail-body;
    in property <[DetailRow]> detail-rows;
    in property <[DetailAction]> detail-actions;
    in-out property <string> content-text;
    in property <string> content-note;
    in property <string> form-title;
    in property <string> form-text;
    in property <string> form-label-1;
    in property <string> form-hint-1;
    in property <string> form-label-2;
    in property <string> form-hint-2;
    in property <string> form-submit;
    in-out property <string> form-error;
    in-out property <string> form-value-1;
    in-out property <string> form-value-2;
    in property <bool> form-project-picker: false;
    in property <[string]> form-project-names;
    in-out property <int> form-project-index: 0;
}

export global Actions {
    callback refresh();
    callback scan-all();
    callback cancel-scan();
    callback search(string);
    callback open-search-hit(int);
    callback filter-projects();
    callback filter-resources();
    callback open-project(int);
    callback open-resource(int);
    callback open-ai(int);
    callback open-hint(int);
    callback open-scope(int);
    callback open-plan(int);
    callback open-adapter(string);
    callback open-package(string);
    callback close-package();
    callback package-page(int);
    callback package-query();
    callback keep-package(string, bool);
    callback open-candidate(int);
    callback open-artifact(int);
    callback filter-candidates();
    callback storage-refresh();
    callback storage-drive(string);
    callback tree-open(int, string);
    callback tree-enter(int);
    callback tree-parent();
    callback approve-scope(string);
    callback new-project();
    callback new-scratch();
    callback show-cli();
    callback detail-action(string);
    callback submit-form(string, string);
    // Experiments
    callback select-experiment(int);
    callback release-session(int);
    callback recheck-sessions();
    callback experiment-action(string, int);
    // System
    callback system-refresh();
    callback system-approve(string);
    callback open-scope-scan(int);
    // Guided start
    callback guide-start();
    callback guide-skip();
    callback guide-disable();
    callback guide-browse();
    callback guide-approve();
    callback guide-sample();
    callback guide-finish();
    // Settings
    callback set-monitoring(bool);
    callback pause-monitoring(int);
    callback set-notifications(bool);
    callback set-updates(bool);
    callback set-source(string, bool);
    callback set-guide(bool);
    callback set-daily-summary(bool);
    callback set-summary-hour(int);
    callback set-quiet(bool, int, int);
    callback set-autostart(bool);
    callback save-scratch-root(string);
    callback browse-scratch-root();
    callback approve-system(string);
    callback check-updates();
    callback backup-now();
    callback export-now(bool);
    callback hide-dashboard();
}
