// Design tokens of the selected nature dashboard (design/dashboard.html).
export global Theme {
    out property <color> ink: #172c48;
    out property <color> muted: #5d6d80;
    out property <color> line: #e6edf3;
    out property <color> canvas: #f3f6f9;
    out property <color> surface: #ffffff;
    out property <color> blue: #246dd6;
    out property <color> blue-hover: #1d6adc;
    out property <color> blue-soft: #e5efff;
    out property <color> green: #159b79;
    out property <color> green-soft: #edf8f3;
    out property <color> amber: #a87a35;
    out property <color> amber-soft: #fff3de;
    out property <color> row: #f8fafc;
    out property <color> row-hover: #f1f6fc;
    out property <color> focus: #2477db;
    out property <length> radius: 13px;
    out property <length> radius-small: 8px;
}

// Line icons (own drawings, GPL-3.0-only). Colour comes from `colorize`.
export global Icons {
    out property <image> activity: @image-url("../assets/icons/activity.svg");
    out property <image> arrow: @image-url("../assets/icons/arrow.svg");
