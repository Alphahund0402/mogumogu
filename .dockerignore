# Allowlist: inventories, personal settings, credentials, .git and host build
# output never enter the build context. Keep the static validator's inputs.
**
!Dockerfile
!compose.yaml
!.dockerignore
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!rustfmt.toml
!build.rs
!build.ps1
!build.cmd
!start.ps1
!start.cmd
!AGENTS.md
!CLAUDE.md
!README.md
!CONTRIBUTING.md
!SECURITY.md
!THIRD_PARTY.md
!LICENSE
!src/
!src/**
!ui/
!ui/**
!assets/
!assets/**
!migrations/
!migrations/**
!profiles/
!profiles/**
!tests/
!tests/**
!scripts/
!scripts/**
!packages/
!packages/**
!security/
!security/**
!docs/
!docs/**
# Linked from README, THIRD_PARTY and docs/; the static validator checks these links.
!design/brand/README.md
!design/brand/index.html
!design/brand/consistent-v2-prompt.md
!design/brand/measurement/README.md
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.agents/
!.agents/skills/
!.agents/skills/**
!.claude/
!.claude/skills/
!.claude/skills/**

# Also exclude these if they occur inside an allowed source directory.
**/__pycache__/**
**/.env
**/.env.*
**/*.local.*
**/*.sqlite3*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.log
**/*.dmp
**/*.exe
**/*.dll
**/mogumogu-export*.json
